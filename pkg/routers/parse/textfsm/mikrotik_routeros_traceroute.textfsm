Value Filldown target ([^\s\]";]+)
Value Filldown source ([^\s\]";]+)
Value Required ttl ([0-9a-fA-F]+)
Value ip ([^;]*)
Value hostname ([^;]*)
Value rtt_ms ([\d.]+)
Value asn (\d+)

Start
  ^.*/tool traceroute.*\saddress=${target} -> Continue
  ^.*/tool traceroute.*\ssrc-address=${source}
  ^target=${target}\s*$$
  ^ttl=${ttl};address=${ip};rtt=${rtt_ms}?\s*$$ -> Record